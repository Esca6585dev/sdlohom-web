# copy to backend/.env on the server
APP_ENV=production
PORT=8090
# public origin of the site; uploads are returned as PUBLIC_URL/uploads/<path> (nginx serves them from disk)
PUBLIC_URL=https://www.sdlohom.edu.tm
UPLOADS_DIR=/var/www/sdlohom-web/backend/uploads
MIGRATIONS_DIR=/var/www/sdlohom-web/backend/migrations

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=sdlohom
DB_PASS=CHANGE_ME
DB_NAME=sdlohom

# only needed if you run bin/migrate from the legacy database on the server
LEGACY_DB_NAME=sdlohomdatabase
LEGACY_HTML_DIR=/var/www/sdlohom-legacy/html

JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
JWT_TTL_HOURS=12
CORS_ORIGINS=https://www.sdlohom.edu.tm,https://sdlohom.edu.tm
TIMEZONE=Asia/Ashgabat
MAX_UPLOAD_MB=64
# behind nginx: read client IP from X-Forwarded-For
TRUST_PROXY=1
IP_HASH_SALT=CHANGE_ME_random

# merkez.bilim.tm centralized news API token (kept server side; can also be set in Admin -> Sazlamalar)
EXTERNAL_NEWS_TOKEN=
