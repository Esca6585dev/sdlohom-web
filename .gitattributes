# Normalise line endings: store LF in the repo; Linux servers need LF for scripts/services.
* text=auto
*.sh text eol=lf
*.service text eol=lf
*.conf text eol=lf
*.go text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.md text eol=lf
*.sql text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.ps1 text eol=crlf

# binaries
*.png binary
*.jpg binary
*.jpeg binary
*.jfif binary
*.gif binary
*.webp binary
*.ico binary
*.mp4 binary
*.pdf binary
*.zip binary
*.docx binary
*.xlsx binary
