# copy to frontend/.env.production on the server (read at build time AND by `npm start`)
# browser -> API through nginx (same origin, no CORS)
NEXT_PUBLIC_API_URL=https://www.sdlohom.edu.tm/api/v1
# server-side rendering -> API directly (faster, no TLS hop)
API_URL=http://127.0.0.1:8090/api/v1
NEXT_PUBLIC_SITE_URL=https://www.sdlohom.edu.tm
